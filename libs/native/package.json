{
  "name": "@wuzz/native",
  "version": "0.0.0",
  "private": true,
  "description": "Code shared by the React Native apps (wuzz, station): layout components, device metrics, the query client and its persister, Sentry, and the MMKV session storage, and a floating bottom sheet. Consumed as source.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./components": "./src/components/index.ts",
    "./device": "./src/device/index.ts",
    "./query": "./src/query/index.ts",
    "./sentry": "./src/sentry.ts",
    "./sheet": "./src/sheet/index.ts",
    "./storage": "./src/storage.ts",
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "native"
  },
  "peerDependencies": {
    "@gorhom/bottom-sheet": "*",
    "@sentry/react-native": "*",
    "@tanstack/react-query": "*",
    "@tanstack/react-query-persist-client": "*",
    "react": "*",
    "react-native": "*",
    "react-native-config": "*",
    "react-native-mmkv": "*",
    "react-native-reanimated": "*",
    "react-native-safe-area-context": "*"
  },
  "devDependencies": {
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.3"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
