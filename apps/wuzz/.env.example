# Copy to .env for your own machine, or .env.staging / .env.production
# to change a shared environment. Used by react-native-config (ENVFILE) —
# see package.json's android/ios scripts for which file each variant loads.
# APP_VERSION = app version (CFBundleShortVersionString on iOS, versionName on Android). Default 1.0.
# APP_DISPLAY_NAME = name shown under the app icon on device (iOS & Android).
# IOS_BUNDLE_ID_SUFFIX = iOS bundle ID suffix, e.g. .staging (optional).
# ANDROID_APPLICATION_ID_SUFFIX = Android applicationId suffix, e.g. .staging (optional).
# API_GATEWAY_URL = host root of the gateway, with no path (e.g. http://localhost:8092 for
#   wuzz-backend). Every endpoint the app calls carries its own /app/v1 prefix (API_V1 in
#   libs/api/src/url.ts). Port 9090 is the `user` service's raw gRPC port, not HTTP — don't
#   point this at it.
# WS_URL = websocket base URL (e.g. ws://localhost:8092, or your machine's LAN IP for physical devices).
# APP_URL_SCHEME = the URL scheme this build registers and accepts for deep links (iOS Info.plist, Android manifest, JS):
#   wuzz in production, wuzz-stg in staging. Must equal APP_DEEPLINK_SCHEME of the backend it talks to, because the
#   backend builds the banner links with it.
# Note: APP_ICON_NAME is NOT read from env — it's hardcoded per build variant
# (AppIcon-Dev / AppIcon-Staging / AppIcon for local/staging/production).
APP_ENV=local
APP_VERSION=1.0
APP_DISPLAY_NAME=
IOS_BUNDLE_ID_SUFFIX=
ANDROID_APPLICATION_ID_SUFFIX=
APP_URL_SCHEME=wuzz
API_GATEWAY_URL=
WS_URL=
# react-native-maps: Google Maps SDK for Android key (console.cloud.google.com).
# Android only — iOS uses Apple Maps by default, no key needed.
GOOGLE_MAPS_API_KEY=

# Required for Instagram Story and Facebook Story sharing (since Jan 2023).
# Create an app at https://developers.facebook.com and set the App ID here.
# FACEBOOK_APP_ID=
# SENTRY_DSN = error reporting target (optional; leave empty to disable).
SENTRY_DSN=

# Set to true to connect to the Reactotron desktop app (port 9091) in dev builds. Leave unset when Reactotron is not open.
REACTOTRON=
