// tmp.xcconfig is generated by scheme Pre-action from .env (Local), .env.staging (Staging)
// or .env.production (Production). Defaults below apply when tmp is missing; tmp overrides
// with env values for the plist. APP_ICON_NAME is hardcoded per scheme's Pre-action (not env-driven).
APP_VERSION = 1.0
APP_DISPLAY_NAME = Wuzz
APP_ICON_NAME = AppIcon
IOS_BUNDLE_ID_SUFFIX =
APP_URL_SCHEME = wuzz

#include? "tmp.xcconfig"

ASSETCATALOG_COMPILER_APPICON_NAME = $(APP_ICON_NAME)

// Swift bridging header — gives Swift access to NitroAutoPrefetcher (Obj-C facade)
// without `import NitroFetch`, which would trigger Clang to scan the pod's
// umbrella header (full of .hpp files) and fail.
SWIFT_OBJC_BRIDGING_HEADER = $(SRCROOT)/Wuzz/Wuzz-Bridging-Header.h
