{
  "name": "@wuzz/wuzz",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "wuzz"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "android": "react-native run-android --active-arch-only",
    "ios": "react-native run-ios",
    "android:local": "cross-env ENVFILE=.env react-native run-android --mode=localDebug --appId com.koobam.wuzz.dev --active-arch-only && adb reverse tcp:8092 tcp:8092",
    "android:staging": "cross-env ENVFILE=.env.staging react-native run-android --mode=stagingDebug --appId com.koobam.wuzz.staging --active-arch-only",
    "android:production": "cross-env ENVFILE=.env.production react-native run-android --mode=productionDebug --appId com.koobam.wuzz --active-arch-only",
    "android:staging:release": "cross-env ENVFILE=.env.staging react-native run-android --mode=stagingRelease --appId com.koobam.wuzz.staging",
    "android:production:release": "cross-env ENVFILE=.env.production react-native run-android --mode=productionRelease --appId com.koobam.wuzz",
    "ios:local": "cross-env ENVFILE=.env react-native run-ios --scheme Local",
    "ios:staging": "cross-env ENVFILE=.env.staging react-native run-ios --scheme Staging",
    "ios:production": "cross-env ENVFILE=.env.production react-native run-ios --scheme Production",
    "ios:staging:release": "cross-env ENVFILE=.env.staging react-native run-ios --scheme Staging --mode Release",
    "ios:production:release": "cross-env ENVFILE=.env.production react-native run-ios --scheme Production --mode Release",
    "run:local": "cross-env ENVFILE=.env react-native run-ios --scheme Local",
    "run:staging": "cross-env ENVFILE=.env.staging react-native run-ios --scheme Staging",
    "run:production": "cross-env ENVFILE=.env.production react-native run-ios --scheme Production",
    "lint": "eslint .",
    "postinstall": "patch-package",
    "start": "react-native start",
    "reverse": "adb reverse tcp:8081 tcp:8081 && adb reverse tcp:8092 tcp:8092 && adb reverse tcp:9091 tcp:9091",
    "test": "jest",
    "test:logic": "jest -c jest.logic.config.js"
  },
