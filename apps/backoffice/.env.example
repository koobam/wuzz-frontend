# Copy to .env for local development (Vite loads .env automatically).
# Base URL of the wuzz backend API.
VITE_API_URL=http://localhost:9090

# Leave empty locally — an unset DSN disables Sentry rather than erroring.
VITE_SENTRY_DSN=
# Set by the pipeline (staging, production). Leave empty locally.
VITE_APP_ENV=
VITE_RELEASE=

# wuzz-support (Phoenix): the team chat, REST at /api and the websocket at /socket.
VITE_SUPPORT_URL=http://localhost:4000
