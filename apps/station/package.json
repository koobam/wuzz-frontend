{
  "name": "@wuzz/station",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "station"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "android": "react-native run-android",
    "android:staging": "cross-env ENVFILE=.env.staging react-native run-android --mode=stagingDebug --appId com.wuzz.station.staging",
    "android:production": "cross-env ENVFILE=.env.production react-native run-android --mode=productionDebug --appId com.wuzz.station",
    "ios": "react-native run-ios",
    "ios:staging": "cross-env ENVFILE=.env.staging react-native run-ios --scheme Staging",
    "ios:production": "cross-env ENVFILE=.env.production react-native run-ios --scheme Production",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/elements": "^2.9.26",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.10",
    "@sentry/react-native": "^8.32.0",
    "@tanstack/react-query": "5.101.2",
    "@wuzz/api": "workspace:*",
    "@wuzz/native": "workspace:*",
    "@wuzz/ui": "workspace:*",
    "i18next": "26.3.3",
    "query-string": "7.1.3",
    "react": "19.2.3",
    "react-i18next": "16.6.6",
    "react-native": "0.87.1",
    "react-native-config": "^1.7.2",
    "react-native-device-info": "^15.0.2",
    "react-native-gesture-handler": "^3.2.1",
    "react-native-mmkv": "^3.3.3",
    "react-native-network-info": "^5.2.2",
    "react-native-nitro-fetch": "^1.6.3",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-safe-area-context": "^5.9.1",
    "react-native-screens": "^4.27.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/runtime": "7.29.7",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.3",
    "@types/react-test-renderer": "19.1.0",
    "babel-plugin-module-resolver": "5.0.3",
    "cross-env": "10.1.0",
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
