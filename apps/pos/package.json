{
  "name": "@wuzz/pos",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "nx": {
    "name": "pos"
  },
  "scripts": {
    "dev": "vite",
    "dev:staging": "vite --mode staging",
    "dev:production": "vite --mode production",
    "routes": "tsr generate",
    "build": "tsr generate && tsc -p tsconfig.json --noEmit && vite build",
    "build:staging": "tsr generate && tsc -p tsconfig.json --noEmit && vite build --mode staging",
    "build:production": "tsr generate && tsc -p tsconfig.json --noEmit && vite build --mode production",
    "typecheck": "tsr generate && tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "preview:staging": "vite preview --mode staging",
    "preview:production": "vite preview --mode production"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@lukemorales/query-key-factory": "1.3.4",
    "@sentry/react": "^11.8.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.31",
    "@tanstack/react-table": "^8.21.3",
    "@wuzz/web-ui": "workspace:*",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.20",
    "i18next": "26.3.3",
    "lucide-react": "^1.61.0",
    "phoenix": "^1.7.21",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.80.0",
    "react-i18next": "16.6.6",
    "react-icomoon": "2.6.1",
    "react-select": "^5.10.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/router-cli": "^1.167.32",
    "@tanstack/router-plugin": "^1.168.34",
    "@types/phoenix": "^1.6.6",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "@vitejs/plugin-react": "^6.0.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.0"
  }
}
